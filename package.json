{
  "name": "cloudcart",
  "version": "0.5.0",
  "private": true,
  "description": "A lightweight, plugin-based, themeable ecommerce platform built natively for Cloudflare Workers Free.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run build:storefront && node scripts/generate-assets.mjs && pnpm run build:admin && node scripts/prepare-admin.mjs && node scripts/prepare-brand.mjs",
    "build:storefront": "pnpm --filter @cloudcart/storefront build",
    "build:admin": "pnpm --filter @cloudcart/admin build",
    "dev": "pnpm run dev:setup && pnpm run build && wrangler dev",
    "dev:worker": "wrangler dev",
    "deploy": "node scripts/deploy.mjs --skip-build",
    "deploy:cloudflare": "node scripts/deploy.mjs",
    "dev:setup": "node scripts/dev-secrets.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:cli": "vitest run --config vitest.cli.config.ts",
    "test:watch": "vitest",
    "cloudcart": "node apps/cli/bin/cloudcart.mjs",
    "cli": "node apps/cli/bin/cloudcart.mjs",
    "publish:jsdelivr": "node scripts/publish-jsdelivr.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:server": "node scripts/e2e-server.mjs",
    "screenshots": "pnpm build && playwright test --config playwright.screenshots.config.ts",
    "docs:dev": "pnpm --filter @cloudcart/docs dev",
    "docs:build": "pnpm --filter @cloudcart/docs build",
    "docs:preview": "pnpm --filter @cloudcart/docs preview",
    "docs:deploy": "pnpm run docs:build && wrangler deploy --config wrangler.docs.jsonc",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudcart/core": "workspace:*",
    "@cloudcart/database": "workspace:*",
    "@cloudcart/plugin-email-notifications": "workspace:*",
    "@cloudcart/plugin-sdk": "workspace:*",
    "@cloudcart/plugin-stripe": "workspace:*",
    "@cloudcart/security": "workspace:*",
    "@cloudcart/shared": "workspace:*",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^24.0.0",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
