{
  "name": "cloudcart",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, plugin-based, themeable ecommerce platform built natively for Cloudflare Workers Free.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run build:storefront && node scripts/generate-assets.mjs && pnpm run build:admin && node scripts/prepare-admin.mjs",
    "build:storefront": "pnpm --filter @cloudcart/storefront build",
    "build:admin": "pnpm --filter @cloudcart/admin build",
    "dev": "pnpm run build && wrangler dev",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:cloudflare": "node scripts/deploy.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudcart/core": "workspace:*",
    "@cloudcart/database": "workspace:*",
    "@cloudcart/plugin-stripe": "workspace:*",
    "@cloudcart/security": "workspace:*",
    "@cloudcart/shared": "workspace:*",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^24.0.0",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
