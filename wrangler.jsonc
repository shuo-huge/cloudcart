{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudcart",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/webhooks/*", "/media/*", "/sitemap.xml", "/robots.txt", "/setup"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudcart",
      "database_id": "3ee15198-1fe3-44e3-a20d-b4822f7065cc",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_ENV": "production",
    "STORE_NAME": "CloudCart",
    "STORE_CURRENCY": "USD",
    "STORE_TIMEZONE": "UTC"
  },
  "observability": {
    "enabled": true
  }
}
